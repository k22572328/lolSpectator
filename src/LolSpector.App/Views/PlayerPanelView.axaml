<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LolSpector.App.ViewModels"
             xmlns:views="using:LolSpector.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320"
             x:Class="LolSpector.App.Views.PlayerPanelView"
             x:DataType="vm:PlayerPanelViewModel">
  <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
          CornerRadius="8" Padding="10" Margin="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
        <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsLoading}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !HasError}">
          <TextBlock Text="單雙排:" Opacity="0.7" />
          <TextBlock Text="{Binding SoloRankSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !HasError}">
          <TextBlock Text="彈性排位:" Opacity="0.7" />
          <TextBlock Text="{Binding FlexRankSummary}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer>
        <StackPanel Spacing="8" IsVisible="{Binding !HasError}">
          <TextBlock Text="近期對戰" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding RecentMatches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:RecentMatchViewModel">
                <views:RecentMatchRowView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TabControl>
            <TabItem Header="單雙排常用角色">
              <ItemsControl ItemsSource="{Binding SoloChampions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ChampionStatCardViewModel">
                    <views:ChampionStatCardView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </TabItem>
            <TabItem Header="彈性排位常用角色">
              <ItemsControl ItemsSource="{Binding FlexChampions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ChampionStatCardViewModel">
                    <views:ChampionStatCardView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </TabItem>
          </TabControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
