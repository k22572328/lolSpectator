<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LolSpector.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LolSpector.App.Views.RecentMatchRowView"
             x:DataType="vm:RecentMatchViewModel">
  <Border Padding="6,4" CornerRadius="4" Margin="0,0,0,4" Background="{Binding ResultBackground}">
    <StackPanel Orientation="Vertical" Spacing="2">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding ResultText}" FontWeight="Bold" />
        <TextBlock Text="{Binding QueueLabel}" Opacity="0.7" />
        <TextBlock Text="{Binding ChampionName}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Position}" Opacity="0.7" />
        <TextBlock Text="{Binding RelativeTime}" Opacity="0.6" HorizontalAlignment="Right" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding Kda}" />
        <TextBlock Text="{Binding CsLine}" />
        <TextBlock Text="{Binding DamageLine}" />
        <TextBlock Text="{Binding GoldLine}" />
        <TextBlock Text="{Binding VisionLine}" />
        <TextBlock Text="{Binding DurationText}" Opacity="0.6" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
